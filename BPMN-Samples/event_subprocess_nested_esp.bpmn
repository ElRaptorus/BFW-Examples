        <bpmn:sequenceFlow id="ESP_Inner_Flow_1" sourceRef="ESP_Inner_Start" targetRef="ESP_Inner_Task" />
        <bpmn:sequenceFlow id="ESP_Inner_Flow_2" sourceRef="ESP_Inner_Task" targetRef="ESP_Inner_End" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_1" name="End">
